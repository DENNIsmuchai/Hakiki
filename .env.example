# Supabase (public client config — safe to expose to the browser)
VITE_SUPABASE_URL=https://xxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=xxxxxx
# -----------------------------------------------------------------------------
# Everything below is a SERVER-SIDE secret. Never put these in this file, and
# never put them in a VITE_ variable — anything prefixed VITE_ is bundled into
# the browser JS and is not a secret. Set these with the Supabase CLI instead:
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#
# ANTHROPIC_API_KEY — used by supabase/functions/extract-order for AI order
# extraction (FR2). If unset, the app still works: the UI falls back to a
# local heuristic parser (see src/services/ai.js).
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically to
# every Edge Function by Supabase — you don't set them yourself.
# -----------------------------------------------------------------------------
